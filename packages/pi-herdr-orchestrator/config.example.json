{
  "roles": {
    "explorer": {
      "kind": "opencode",
      "model": "opencode/deepseek-v4-flash-free",
      "args": ["--model", "opencode/deepseek-v4-flash-free"]
    },
    "builder": {
      "kind": "opencode",
      "model": "opencode/deepseek-v4-flash-free",
      "args": ["--model", "opencode/deepseek-v4-flash-free"]
    },
    "verifier": {
      "kind": "opencode",
      "model": "opencode/deepseek-v4-flash-free",
      "args": ["--model", "opencode/deepseek-v4-flash-free"]
    }
  },
  "reviewer": {
    "kind": "pi",
    "model": "gpt-5.6-sol",
    "args": ["--model", "gpt-5.6-sol", "--thinking", "medium"]
  },
  "ledgerDir": ".herdr-runs",
  "startDelayMs": 2000,
  "promptTimeoutMs": 120000,
  "readLines": 120
}
